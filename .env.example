# ── Supabase (optional) ─────────────────────────────────────────────
# If these are left blank, the app runs entirely in local Demo Mode:
# all data is generated from src/data/* and persisted in localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI Mentor (optional) ────────────────────────────────────────────
# If VITE_AI_API_KEY is blank, the AI Mentor and Interview Prep pages
# automatically use the deterministic Offline Mentor fallback engine
# (src/lib/mentorFallback.ts) instead of calling a live model.
#
# VITE_AI_BASE_URL should point at an OpenAI-compatible /chat/completions
# endpoint. Never commit a real key — this file is a template only.
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.openai.com/v1
VITE_AI_MODEL=gpt-4o-mini
